{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    ".*/**/*.ts",
    ".*/**/*.mts",
    "**/*.ts",
    "**/*.mts",
    "**/*.vue"
  ]
}
