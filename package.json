{
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev --port 5200",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "all:fix": "npm run lint:fix && npm run format:fix",
    "sa": "vue-tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:e2e": "playwright install chromium",
    "stories": "storybook dev -p 6200 --no-open",
    "stories:build": "storybook build",
    "trigma:analyze": "node --experimental-transform-types scripts/analyze-trigma.mjs",
    "trigma:difficulty": "node --experimental-transform-types scripts/rank-trigma.mjs",
    "pre-commit": "npm run sa && npm run lint && npm run format && npm run test && npm run test:e2e && npm run build && npm run stories:build",
    "pre-commit:install": "printf '#!/bin/sh\\nnpm run pre-commit\\n' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "postinstall": "npm run pre-commit:install && npm run setup:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/vue3-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
