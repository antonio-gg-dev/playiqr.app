{
  "plugins": [
    "prettier-plugin-css-order",
    "prettier-plugin-multiline-arrays",
    "prettier-plugin-tailwindcss"
  ],
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "singleAttributePerLine": true,
  "printWidth": 120,
  "proseWrap": "always",
  "multilineArraysWrapThreshold": 1
}
